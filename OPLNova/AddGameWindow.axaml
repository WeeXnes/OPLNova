<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Height="420"
        Width="650"
        CanResize="False"
        x:Class="OPLNova.AddGameWindow"
        Title="Install Game"
        WindowStartupLocation="CenterScreen"
        Loaded="Control_OnLoaded"
        Background="{StaticResource ObsidianBackground}"
        Foreground="{StaticResource ObsidianText}">
    <Grid ColumnDefinitions="Auto, *" Margin="20">
        <!-- Left: Game Cover -->
        <Border Width="205" Height="292" Background="{StaticResource ObsidianSurface}" CornerRadius="8" ClipToBounds="True" BoxShadow="0 4 12 0 #80000000" PointerPressed="CoverImage_OnPointerPressed" VerticalAlignment="Top">
            <Grid>
                <Image Name="CoverImage" Source="Assets/missing.png" Stretch="UniformToFill"/>
                <TextBlock Text="Click to Change Cover" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="10" Foreground="{StaticResource ObsidianTextDim}"/>
            </Grid>
        </Border>

        <!-- Right: Form -->
        <Border Grid.Column="1" Background="{StaticResource ObsidianSurface}" CornerRadius="8" Margin="20,0,0,0" Padding="20">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Game Name" FontWeight="SemiBold" Foreground="{StaticResource ObsidianTextDim}"/>
                    <TextBox Name="GameNameBox" MaxLength="32" TextChanged="GameNameBox_OnTextChanged"/>
                </StackPanel>

                <Grid ColumnDefinitions="*, 12, *">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Serial" FontWeight="SemiBold" Foreground="{StaticResource ObsidianTextDim}"/>
                        <TextBox Name="SerialBox" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Method" FontWeight="SemiBold" Foreground="{StaticResource ObsidianTextDim}"/>
                        <ComboBox Name="InstallationMethodBox" HorizontalAlignment="Stretch" SelectionChanged="InstallationMethodBox_OnSelectionChanged"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="ISO Path" FontWeight="SemiBold" Foreground="{StaticResource ObsidianTextDim}"/>
                    <TextBox Name="IsoPathBox" IsEnabled="False" FontSize="11"/>
                </StackPanel>

                <StackPanel Spacing="10" Margin="0,10,0,0">
                    <Button Name="InstallButton" Content="Install Game" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="InstallButton_OnClick"/>
                    <ProgressBar Name="InstallationProgressBar" Height="4" Background="{StaticResource ObsidianSurfaceLight}" Foreground="{StaticResource ObsidianAccent}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
