<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OPLNova.App"
             RequestedThemeVariant="Default"
             >
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <SolidColorBrush x:Key="ObsidianBackground">#0F0F0F</SolidColorBrush>
        <SolidColorBrush x:Key="ObsidianSurface">#1A1A1A</SolidColorBrush>
        <SolidColorBrush x:Key="ObsidianSurfaceLight">#252525</SolidColorBrush>
        <SolidColorBrush x:Key="ObsidianAccent">#9D4EDD</SolidColorBrush>
        <SolidColorBrush x:Key="ObsidianAccentHover">#B072E6</SolidColorBrush>
        <SolidColorBrush x:Key="ObsidianText">#F0F0F0</SolidColorBrush>
        <SolidColorBrush x:Key="ObsidianTextDim">#A0A0A0</SolidColorBrush>
        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        
        <!-- Global Button Style -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource ObsidianAccent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ObsidianAccentHover}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Global TextBox Style -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{StaticResource ObsidianSurfaceLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource ObsidianAccent}" />
            <Setter Property="Background" Value="{StaticResource ObsidianSurfaceLight}" />
        </Style>

        <!-- Global ListBox Style -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ObsidianSurfaceLight}" />
        </Style>
        <Style Selector="ListBoxItem:pointerpressed">
            <Setter Property="IsSelected" Value="True" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ObsidianSurfaceLight}" />
            <Setter Property="BorderBrush" Value="{StaticResource ObsidianAccent}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
        </Style>
        
        <!-- Global ToggleSwitch Style -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
        </Style>

    </Application.Styles>
</Application>