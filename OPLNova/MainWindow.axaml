<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OPLNova.Core"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="OPLNova.MainWindow"
        Title="OPLNova"
        Background="{StaticResource ObsidianBackground}"
        Width="1000"
        Height="650"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Control_OnLoaded"
        KeyDown="MainWindow_OnKeyDown"
        Foreground="{StaticResource ObsidianText}">
    <Grid RowDefinitions="*, Auto">
        <Grid Name="MainGrid" Grid.Row="0" ColumnDefinitions="300, 1, *" Margin="12">
        <!-- Left Panel: Games List -->
        <Border Grid.Column="0" Background="{StaticResource ObsidianSurface}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="0,0,6,0">
            <Grid RowDefinitions="Auto, Auto, *">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="12,12,12,4" Height="32">
                    <TextBlock Text="LIBRARY" 
                               VerticalAlignment="Center" 
                               FontWeight="Black" 
                               FontSize="10" 
                               Foreground="{StaticResource ObsidianTextDim}" 
                               LetterSpacing="2"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <Button Name="ListViewButton" Click="ViewToggle_Click" Background="Transparent" BorderThickness="0" Width="36" Height="32" Padding="0">
                            <TextBlock Text="≡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="translateY(1px)"/>
                        </Button>
                        <Button Name="GridViewButton" Click="ViewToggle_Click" Background="Transparent" BorderThickness="0" Opacity="0.5" Width="36" Height="32" Padding="0">
                            <TextBlock Text="⊞" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBox Grid.Row="1" 
                         Name="SearchTextBox" 
                         Watermark="Search games..." 
                         Margin="12,0,12,12" 
                         Height="32"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_OnTextChanged"/>
                
                <Panel Grid.Row="2">
                    <!-- List View -->
                    <ListBox Name="GamesList" SelectionChanged="GamesList_OnSelectionChanged" Background="Transparent">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Uninstall Game" Click="DeleteButton" Foreground="#FF5555">
                                                <MenuItem.Icon>
                                                    <Image Source="Assets/bin.png" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Add New Game" Click="OpenFileButton_Clicked"/>
                                            <MenuItem Header="Refresh List" Click="Context_RefreshGames"/>
                                            <MenuItem Header="Bulk Scrape Art" Click="BulkScrape_Click"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:Game">
                                <Grid ColumnDefinitions="Auto, 12, *">
                                    <Panel Grid.Column="0" Width="32" Height="32">
                                        <!-- Custom Disc Icon -->
                                        <Image IsVisible="{Binding ArtworkDVD, Converter={x:Static ObjectConverters.IsNotNull}}" 
                                               Source="{Binding ArtworkDVD}" 
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        
                                        <!-- Default Icons (Visible only if ArtworkDVD is null) -->
                                        <Panel IsVisible="{Binding ArtworkDVD, Converter={x:Static ObjectConverters.IsNull}}">
                                            <Image IsVisible="{Binding Icon.ShowDVD}" RenderOptions.BitmapInterpolationMode="HighQuality" Source="Assets/dvd.png"/>
                                            <Image IsVisible="{Binding Icon.ShowCD}" RenderOptions.BitmapInterpolationMode="HighQuality" Source="Assets/cd.png"/>
                                        </Panel>
                                    </Panel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding GameID}" FontSize="10" Foreground="{StaticResource ObsidianTextDim}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="EmptyAreaContextMenu">
                                <MenuItem Header="Add New Game" Click="OpenFileButton_Clicked"/>
                                <MenuItem Header="Refresh List" Click="Context_RefreshGames"/>
                                <Separator/>
                                <MenuItem Header="Bulk Scrape Art" Click="BulkScrape_Click"/>
                            </ContextMenu>                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- Grid View -->
                    <ScrollViewer Name="GamesGridScroller" IsVisible="False">
                        <ScrollViewer.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Add New Game" Click="OpenFileButton_Clicked"/>
                                <MenuItem Header="Refresh List" Click="Context_RefreshGames"/>
                                <Separator/>
                                <MenuItem Header="Bulk Scrape Art" Click="BulkScrape_Click"/>
                            </ContextMenu>
                        </ScrollViewer.ContextMenu>
                        <ItemsControl Name="GamesGrid" Padding="8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:Game">
                                    <Button Classes="GridItem" Margin="4" Padding="0" Background="Transparent" Click="GameGridItem_Click" Tag="{Binding}">
                                        <StackPanel Width="80" Spacing="4">
                                            <Border CornerRadius="4" ClipToBounds="True" Height="110" BoxShadow="0 2 4 0 #40000000">
                                                <Image Source="{Binding ArtworkFront, FallbackValue={StaticResource missing_image}}" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="10" Height="30" VerticalAlignment="Top" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
                
                <StackPanel Grid.Row="2" Name="NoGamesMessage" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="False" Spacing="16">
                    <Image Source="Assets/missing.png" Width="48" Height="48" Opacity="0.2"/>
                    <TextBlock Text="No Games Found" 
                               HorizontalAlignment="Center" 
                               Foreground="{StaticResource ObsidianTextDim}"
                               FontWeight="SemiBold"/>
                    <Button Content="Refresh" 
                            Click="Context_RefreshGames" 
                            HorizontalAlignment="Center" 
                            Padding="12,4"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Vertical Separator -->
        <Rectangle Grid.Column="1" Fill="{StaticResource ObsidianSurfaceLight}" Width="1" Margin="6,20"/>

        <!-- Center Panel: Content -->
        <Border Grid.Column="2" Margin="6,0">
            <Grid>
                <!-- Welcome Panel -->
                <Border Name="WelcomePanel" Background="{StaticResource ObsidianSurface}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="12">
                            <Image Source="Assets/oplnova.png" Width="128" Height="128" HorizontalAlignment="Center"/>
                            <TextBlock Text="Welcome to OPLNova"
                                       Name="WelcomeTextTop"
                                       HorizontalAlignment="Center"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                            <TextBlock Name="LibraryStatusText" 
                                       Text="The ultimate PS2 library manager"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource ObsidianTextDim}"/>
                        </StackPanel>
                        
                        <Separator Background="{StaticResource ObsidianSurfaceLight}" Margin="0,10"/>
                        
                        <StackPanel Spacing="16">
                            <TextBlock Name="LandingActionHeader" Text="Get Started" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <UniformGrid Columns="1" Margin="20,0">
                                <Button Content="Add New Game" 
                                        Classes="accent" 
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Center"
                                        Click="OpenFileButton_Clicked"
                                        Margin="0,0,0,8"/>
                                <Button Content="GitHub Repository" 
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Center"
                                        Click="OnRepositoryLinkClicked"/>
                            </UniformGrid>
                        </StackPanel>

                        <Border Background="{StaticResource ObsidianSurfaceLight}" CornerRadius="4" Padding="12" Margin="0,10,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Pro Tip" FontWeight="Bold" FontSize="12" Foreground="{StaticResource ObsidianAccent}"/>
                                <TextBlock Text="You can right-click on the games list to quickly add new games or refresh the library." 
                                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource ObsidianTextDim}"/>
                            </StackPanel>
                        </Border>
                        
                        <TextBlock Text="by WeeXnes"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource ObsidianTextDim}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Unified Game Details & Edit Panel -->
                <Grid Name="GameEdit" IsVisible="False" RowDefinitions="*, Auto">
                    <ScrollViewer Grid.Row="0">
                        <StackPanel Spacing="12">
                            <!-- Section 1: Artwork & Header Info -->
                            <Border Background="{StaticResource ObsidianSurface}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="20">
                                <Grid ColumnDefinitions="Auto, 24, *">
                                    <!-- Cover Area -->
                                    <StackPanel Grid.Column="0" Spacing="12" VerticalAlignment="Top">
                                        <!-- Fixed Aspect Ratio for PS2 Cover (180:250) and Stretch="Uniform" -->
                                        <Border Width="180" Height="250" Background="#10000000" CornerRadius="8" ClipToBounds="True" BoxShadow="0 4 12 0 #80000000" PointerPressed="CoverImage_OnPointerPressed" Name="CoverContainer">
                                            <Grid>
                                                <Image Name="CoverImage" Source="Assets/missing.png" Stretch="Uniform"/>
                                                <TextBlock Name="CoverTextHint" Text="Click to Change" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" Background="#A0000000" Padding="4"/>
                                            </Grid>
                                        </Border>
                                        <Grid ColumnDefinitions="*, 8, *">
                                            <Button Grid.Column="0" Content="←" Click="PrevButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                            <Button Grid.Column="2" Content="→" Click="NextButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Basic Info -->
                                    <StackPanel Grid.Column="2" Spacing="16">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="GAME TITLE" FontWeight="Black" FontSize="10" Foreground="{StaticResource ObsidianTextDim}" LetterSpacing="1"/>
                                            <TextBox Name="NameTextBox_Edit" FontSize="20" FontWeight="Bold"/>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto">
                                            <TextBlock Text="Serial:" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource ObsidianTextDim}" Margin="0,0,12,8"/>
                                            <TextBlock Name="GameIdTextBlock" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" FontSize="14"/>
                                            
                                            <TextBlock Text="Size:" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource ObsidianTextDim}" Margin="0,0,12,8"/>
                                            <TextBlock Name="IsoSizeTextBlock" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" FontSize="14"/>
                                            
                                            <TextBlock Text="Added:" Grid.Row="2" Grid.Column="0" Foreground="{StaticResource ObsidianTextDim}" Margin="0,0,12,8"/>
                                            <TextBlock Name="GameDateTextBlock" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" FontSize="14"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Section 2: Settings -->
                            <Border Background="{StaticResource ObsidianSurface}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="20">
                                <StackPanel Spacing="24">
                                    <!-- VMC Settings -->
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="VIRTUAL MEMORY CARDS" FontWeight="Black" FontSize="10" Foreground="{StaticResource ObsidianTextDim}" LetterSpacing="1"/>
                                        <Grid ColumnDefinitions="*, 12, *">
                                            <StackPanel Grid.Column="0" Spacing="6">
                                                <TextBlock Text="Slot 1" FontSize="11" Foreground="{StaticResource ObsidianTextDim}"/>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <ComboBox Name="VMC_1" HorizontalAlignment="Stretch" SelectionChanged="VMC_1_OnSelectionChanged"/>
                                                    <Button Grid.Column="1" Content="+" Click="CreateVMC_Click" Margin="4,0,0,0" ToolTip.Tip="Create New VMC"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="6">
                                                <TextBlock Text="Slot 2" FontSize="11" Foreground="{StaticResource ObsidianTextDim}"/>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <ComboBox Name="VMC_2" HorizontalAlignment="Stretch" SelectionChanged="VMC_2_OnSelectionChanged"/>
                                                    <Button Grid.Column="1" Content="+" Click="CreateVMC_Click" Margin="4,0,0,0" ToolTip.Tip="Create New VMC"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Compatibility Modes -->
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="COMPATIBILITY MODES" FontWeight="Black" FontSize="10" Foreground="{StaticResource ObsidianTextDim}" LetterSpacing="1"/>
                                        <Border Background="{StaticResource ObsidianSurfaceLight}" CornerRadius="8" Padding="12">
                                            <UniformGrid Columns="3">
                                                <ToggleSwitch Name="toggle_mode1" Content="Mode 1" IsCheckedChanged="Toggle_mode_OnIsCheckedChanged"/>
                                                <ToggleSwitch Name="toggle_mode2" Content="Mode 2" IsCheckedChanged="Toggle_mode_OnIsCheckedChanged"/>
                                                <ToggleSwitch Name="toggle_mode3" Content="Mode 3" IsCheckedChanged="Toggle_mode_OnIsCheckedChanged"/>
                                                <ToggleSwitch Name="toggle_mode4" Content="Mode 4" IsCheckedChanged="Toggle_mode_OnIsCheckedChanged"/>
                                                <ToggleSwitch Name="toggle_mode5" Content="Mode 5" IsCheckedChanged="Toggle_mode_OnIsCheckedChanged"/>
                                                <ToggleSwitch Name="toggle_mode6" Content="Mode 6" IsCheckedChanged="Toggle_mode_OnIsCheckedChanged"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Tools -->
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="TOOLS" FontWeight="Black" FontSize="10" Foreground="{StaticResource ObsidianTextDim}" LetterSpacing="1"/>
                                        <StackPanel Spacing="8">
                                            <Button Content="Calculate Checksums" Click="ChecksumButtonOnClick" HorizontalAlignment="Stretch"/>
                                            <Border Background="{StaticResource ObsidianSurfaceLight}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12" IsVisible="False" Name="ChecksumArea">
                                                <StackPanel Spacing="4">
                                                    <SelectableTextBlock Text="MD5" FontSize="10" Foreground="{StaticResource ObsidianTextDim}"/>
                                                    <SelectableTextBlock Name="MD5TextBlock" FontSize="12" FontFamily="Consolas,Monospace"/>
                                                    <SelectableTextBlock Text="SHA1" FontSize="10" Foreground="{StaticResource ObsidianTextDim}" Margin="0,8,0,0"/>
                                                    <SelectableTextBlock Name="SHATextBlock" FontSize="12" FontFamily="Consolas,Monospace"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Sticky Footer -->
                    <Border Grid.Row="1" Background="{StaticResource ObsidianSurface}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="20" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*, 12, *">
                            <Button Content="Undo Changes" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Undo_OnClick"/>
                            <Button Content="Save Changes" Classes="accent" Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Save_OnClick"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <Border Grid.Row="1" Height="28" Background="{StaticResource ObsidianSurface}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource ObsidianSurfaceLight}">
        <Grid ColumnDefinitions="*, Auto" Margin="12,0">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Total Games:" Foreground="{StaticResource ObsidianTextDim}" FontSize="10"/>
                    <TextBlock Name="TotalGamesStat" FontWeight="Bold" FontSize="10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Total Size:" Foreground="{StaticResource ObsidianTextDim}" FontSize="10"/>
                    <TextBlock Name="TotalSizeStat" FontWeight="Bold" FontSize="10"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="OPLNova v1.0" FontSize="10" Foreground="{StaticResource ObsidianTextDim}" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Grid>
</Window>
