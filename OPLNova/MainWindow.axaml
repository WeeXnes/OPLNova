<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OPLNova.Core"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="OPLNova.MainWindow"
        Title="OPLNova"
        Background="{StaticResource ObsidianBackground}"
        Width="1050"
        Height="620"
        MinHeight="550"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Loaded="Control_OnLoaded"
        Foreground="{StaticResource ObsidianText}">
    <Grid Name="MainGrid" ColumnDefinitions="300, 1, *, 350" Margin="12">
        <!-- Left Panel: Games List -->
        <Border Grid.Column="0" Background="{StaticResource ObsidianSurface}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="0,0,6,0">
            <Grid>
                <ListBox Name="GamesList" SelectionChanged="GamesList_OnSelectionChanged">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Uninstall Game" Click="DeleteButton" Foreground="#FF5555">
                                            <MenuItem.Icon>
                                                <Image Source="Assets/bin.png" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:Game">
                            <Grid ColumnDefinitions="Auto, 12, *">
                                <Panel Grid.Column="0" Width="24" Height="24">
                                    <Image IsVisible="{Binding Icon.ShowDVD}" RenderOptions.BitmapInterpolationMode="HighQuality" Source="Assets/dvd.png"/>
                                    <Image IsVisible="{Binding Icon.ShowCD}" RenderOptions.BitmapInterpolationMode="HighQuality" Source="Assets/cd.png"/>
                                </Panel>
                                <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="EmptyAreaContextMenu">
                            <MenuItem Header="Add New Game" Click="OpenFileButton_Clicked"/>
                            <MenuItem Header="Refresh List" Click="Context_RefreshGames"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                
                <StackPanel Name="NoGamesMessage" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="False" Spacing="16">
                    <Image Source="Assets/missing.png" Width="48" Height="48" Opacity="0.2"/>
                    <TextBlock Text="No Games Found" 
                               HorizontalAlignment="Center" 
                               Foreground="{StaticResource ObsidianTextDim}"
                               FontWeight="SemiBold"/>
                    <Button Content="Refresh" 
                            Click="Context_RefreshGames" 
                            HorizontalAlignment="Center" 
                            Padding="12,4"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Vertical Separator -->
        <Rectangle Grid.Column="1" Fill="{StaticResource ObsidianSurfaceLight}" Width="1" Margin="6,20"/>

        <!-- Center Panel: Content -->
        <Border Grid.Column="2" Margin="6,0">
            <Grid>
                <!-- Welcome Panel -->
                <Border Name="WelcomePanel" Background="{StaticResource ObsidianSurface}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="12">
                            <Image Source="Assets/oplnova.png" Width="128" Height="128" HorizontalAlignment="Center"/>
                            <TextBlock Text="Welcome to OPLNova"
                                       Name="WelcomeTextTop"
                                       HorizontalAlignment="Center"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                            <TextBlock Name="LibraryStatusText" 
                                       Text="The ultimate PS2 library manager"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource ObsidianTextDim}"/>
                        </StackPanel>
                        
                        <Separator Background="{StaticResource ObsidianSurfaceLight}" Margin="0,10"/>
                        
                        <StackPanel Spacing="16">
                            <TextBlock Name="LandingActionHeader" Text="Get Started" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <UniformGrid Columns="1" Margin="20,0">
                                <Button Content="Add New Game" 
                                        Classes="accent" 
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Center"
                                        Click="OpenFileButton_Clicked"
                                        Margin="0,0,0,8"/>
                                <Button Content="GitHub Repository" 
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Center"
                                        Click="OnRepositoryLinkClicked"/>
                            </UniformGrid>
                        </StackPanel>

                        <Border Background="{StaticResource ObsidianSurfaceLight}" CornerRadius="4" Padding="12" Margin="0,10,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Pro Tip" FontWeight="Bold" FontSize="12" Foreground="{StaticResource ObsidianAccent}"/>
                                <TextBlock Text="You can right-click on the games list to quickly add new games or refresh the library." 
                                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource ObsidianTextDim}"/>
                            </StackPanel>
                        </Border>
                        
                        <TextBlock Text="by WeeXnes"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource ObsidianTextDim}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Game Edit Panel -->
                <Border Name="GameEdit" IsVisible="False" Background="{StaticResource ObsidianSurface}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="20">
                    <Grid RowDefinitions="*, Auto">
                        <ScrollViewer Grid.Row="0">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Display Name" FontWeight="SemiBold" Foreground="{StaticResource ObsidianTextDim}"/>
                                    <TextBox Name="NameTextBox_Edit"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*, 16, *">
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Text="Virtual Memory Card 1" FontWeight="SemiBold" Foreground="{StaticResource ObsidianTextDim}"/>
                                        <ComboBox Name="VMC_1" HorizontalAlignment="Stretch" SelectionChanged="VMC_1_OnSelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="8">
                                        <TextBlock Text="Virtual Memory Card 2" FontWeight="SemiBold" Foreground="{StaticResource ObsidianTextDim}"/>
                                        <ComboBox Name="VMC_2" HorizontalAlignment="Stretch" SelectionChanged="VMC_2_OnSelectionChanged"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Compatibility Modes" FontWeight="SemiBold" Foreground="{StaticResource ObsidianTextDim}"/>
                                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *">
                                        <ToggleSwitch Name="toggle_mode1" Content="Mode 1" Grid.Row="0" Grid.Column="0" IsCheckedChanged="Toggle_mode_OnIsCheckedChanged"/>
                                        <ToggleSwitch Name="toggle_mode2" Content="Mode 2" Grid.Row="1" Grid.Column="0" IsCheckedChanged="Toggle_mode_OnIsCheckedChanged"/>
                                        <ToggleSwitch Name="toggle_mode3" Content="Mode 3" Grid.Row="2" Grid.Column="0" IsCheckedChanged="Toggle_mode_OnIsCheckedChanged"/>
                                        <ToggleSwitch Name="toggle_mode4" Content="Mode 4" Grid.Row="0" Grid.Column="1" IsCheckedChanged="Toggle_mode_OnIsCheckedChanged"/>
                                        <ToggleSwitch Name="toggle_mode5" Content="Mode 5" Grid.Row="1" Grid.Column="1" IsCheckedChanged="Toggle_mode_OnIsCheckedChanged"/>
                                        <ToggleSwitch Name="toggle_mode6" Content="Mode 6" Grid.Row="2" Grid.Column="1" IsCheckedChanged="Toggle_mode_OnIsCheckedChanged"/>
                                    </Grid>
                                </StackPanel>

                                <Button Content="Calculate Checksums" Click="ChecksumButtonOnClick" HorizontalAlignment="Stretch"/>
                                
                                <Border Background="{StaticResource ObsidianSurfaceLight}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12" IsVisible="False" Name="ChecksumArea">
                                    <StackPanel Spacing="4">
                                        <SelectableTextBlock Text="MD5" FontSize="10" Foreground="{StaticResource ObsidianTextDim}"/>
                                        <SelectableTextBlock Name="MD5TextBlock" FontSize="12" FontFamily="Consolas,Monospace"/>
                                        <SelectableTextBlock Text="SHA1" FontSize="10" Foreground="{StaticResource ObsidianTextDim}" Margin="0,8,0,0"/>
                                        <SelectableTextBlock Name="SHATextBlock" FontSize="12" FontFamily="Consolas,Monospace"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        
                        <Grid Grid.Row="1" ColumnDefinitions="*, 12, *" Margin="0,20,0,0">
                            <Button Content="Undo" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Undo_OnClick"/>
                            <Button Content="Save Changes" Classes="accent" Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Save_OnClick"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Panel: Info -->
        <Border Name="RightPanel" Grid.Column="3" Background="{StaticResource ObsidianSurface}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="6,0,0,0" Padding="20">
            <Grid>
                <StackPanel Name="GameInfoPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                    <Image Source="Assets/missing.png" Width="64" Height="64" Opacity="0.1"/>
                    <TextBlock Text="No Game Selected" 
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource ObsidianTextDim}"/>
                </StackPanel>

                <Grid RowDefinitions="Auto, *, Auto" Name="GameInfo" IsVisible="False">
                    <!-- Navigation & Cover -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,20">
                        <Button Content="←" Click="PrevButton" Padding="8"/>
                        <Border Grid.Column="1" Width="180" Height="250" Margin="10,0" CornerRadius="8" ClipToBounds="True" BoxShadow="0 4 12 0 #80000000" PointerPressed="CoverImage_OnPointerPressed" Name="CoverContainer">
                            <Grid>
                                <Image Name="CoverImage" Source="Assets/missing.png" Stretch="UniformToFill"/>
                                <TextBlock Name="CoverTextHint" Text="Click to Change" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" Background="#A0000000" Padding="4"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="2" Content="→" Click="NextButton" Padding="8"/>
                    </Grid>

                    <!-- Details -->
                    <StackPanel Grid.Row="1" Spacing="12">
                        <TextBlock Name="GameNameTextBlock" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <Separator Background="{StaticResource ObsidianSurfaceLight}"/>
                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto">
                            <TextBlock Text="Serial:" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource ObsidianTextDim}" Margin="0,0,12,4"/>
                            <TextBlock Name="GameIdTextBlock" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
                            
                            <TextBlock Text="Size:" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource ObsidianTextDim}" Margin="0,0,12,4"/>
                            <TextBlock Name="IsoSizeTextBlock" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"/>
                            
                            <TextBlock Text="Added:" Grid.Row="2" Grid.Column="0" Foreground="{StaticResource ObsidianTextDim}" Margin="0,0,12,4"/>
                            <TextBlock Name="GameDateTextBlock" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
