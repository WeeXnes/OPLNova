<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="OPLNova.Setup"
        WindowStartupLocation="CenterScreen"
        Title="Setup OPLNova"        
        Height="400"
        Width="600"
        CanResize="False"
        Background="{StaticResource ObsidianBackground}"
        Foreground="{StaticResource ObsidianText}"
        Closing="Window_OnClosing">
    <Border Background="{StaticResource ObsidianSurface}" CornerRadius="12" Margin="40" Padding="30">
        <StackPanel Spacing="24" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="8">
                <TextBlock Name="InfoText1" Text="Welcome to OPLNova" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Name="InfoText2" Text="Let's get your library ready" Foreground="{StaticResource ObsidianTextDim}" HorizontalAlignment="Center"/>
            </StackPanel>
            
            <Separator Background="{StaticResource ObsidianSurfaceLight}"/>
            
            <StackPanel Spacing="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="OPLNova API URL" Foreground="{StaticResource ObsidianTextDim}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                    <TextBox Name="ApiUrlTextBox" 
                             Watermark="http://localhost:3000" 
                             HorizontalAlignment="Stretch" 
                             Text="http://localhost:3000"
                             ToolTip.Tip="The API for scraping artwork. You can self-host this using OPLNova VAPI (https://code.weexnes.dev/oplnova_vapi)"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Select the path to your PS2 Game Library" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" HorizontalAlignment="Center" Foreground="{StaticResource ObsidianTextDim}" FontSize="12" FontWeight="SemiBold"/>
                    <Button Name="OpenLibraryButton" Content="Select Library Folder" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OpenLibraryButton_OnClick"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
